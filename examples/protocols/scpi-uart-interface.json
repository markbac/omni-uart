{
  "title": "SCPI (Standard Commands for Programmable Instruments) over RS-232",
  "version": "SCPI-99 / IEEE 488.2",
  "description": "ASCII line-based instrument control (oscilloscopes, PSUs, DMMs). Baud is configured manually on both sides -- no auto-negotiation -- and commonly must match exactly or the instrument just doesn't respond, with no error reported at all. Chains multiple independent commands onto one physical line via ';', which compoundMessageDelimiter exists specifically for.",
  "physicalLayer": {
    "baudRate": [
      9600,
      19200,
      38400,
      57600,
      115200
    ],
    "defaultBaudRate": 9600,
    "dataBits": 8,
    "parity": "none",
    "stopBits": 1
  },
  "encoding": {
    "byteOrder": "big-endian",
    "textEncoding": "ascii"
  },
  "framing": {
    "style": "delimiter-framed",
    "endDelimiter": 10
  },
  "integrityCheck": {
    "algorithm": "none"
  },
  "commandResponseModel": {
    "initiator": "client",
    "responseTimeoutMs": 2000
  },
  "compoundMessageDelimiter": ";",
  "commands": [
    {
      "name": "Identify",
      "tags": ["scpi/system", "dashboard"],
      "description": "*IDN? System identification query.",
      "fields": [
        {
          "name": "text",
          "type": "string",
          "constValue": "*IDN?",
          "role": "discriminator"
        }
      ]
    },
    {
      "name": "Reset",
      "tags": ["scpi/system"],
      "description": "*RST System reset command.",
      "fields": [
        {
          "name": "text",
          "type": "string",
          "constValue": "*RST",
          "role": "discriminator"
        }
      ]
    },
    {
      "name": "ClearStatus",
      "tags": ["scpi/system"],
      "description": "*CLS Clear status registers.",
      "fields": [
        {
          "name": "text",
          "type": "string",
          "constValue": "*CLS",
          "role": "discriminator"
        }
      ]
    },
    {
      "name": "MeasureVoltageDC",
      "tags": ["scpi/measure", "dashboard"],
      "description": "MEAS:VOLT:DC? Measure DC voltage in Volts.",
      "fields": [
        {
          "name": "text",
          "type": "string",
          "constValue": "MEAS:VOLT:DC?",
          "role": "discriminator"
        }
      ]
    },
    {
      "name": "MeasureCurrentDC",
      "tags": ["scpi/measure"],
      "description": "MEAS:CURR:DC? Measure DC current in Amperes.",
      "fields": [
        {
          "name": "text",
          "type": "string",
          "constValue": "MEAS:CURR:DC?",
          "role": "discriminator"
        }
      ]
    },
    {
      "name": "SetVoltageOutput",
      "tags": ["scpi/source"],
      "description": "SOUR:VOLT <val> Set programmable power supply output voltage.",
      "fields": [
        {
          "name": "prefix",
          "type": "string",
          "constValue": "SOUR:VOLT ",
          "role": "discriminator"
        },
        {
          "name": "voltage",
          "type": "float",
          "unit": "V"
        }
      ]
    }
  ],
  "responses": [
    {
      "name": "IdentifyResult",
      "description": "e.g. 'ACME,MM7,SN12345,FW2.1'",
      "fields": [
        {
          "name": "manufacturer",
          "type": "string",
          "delimiter": ","
        },
        {
          "name": "model",
          "type": "string",
          "delimiter": ","
        },
        {
          "name": "serial",
          "type": "string",
          "delimiter": ","
        },
        {
          "name": "firmware",
          "type": "string"
        }
      ]
    }
  ]
}