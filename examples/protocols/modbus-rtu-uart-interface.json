{
  "title": "Modbus RTU",
  "version": "1.0",
  "description": "Modbus over serial, RTU transmission mode. Frame boundaries are marked by line silence rather than sync bytes or a length field.",
  "physicalLayer": {
    "dataBits": 8,
    "parity": "even",
    "stopBits": 1,
    "portType": "rs485",
    "electricalStandard": "rs485",
    "duplex": "half",
    "transmitEnableControl": "rts-toggle"
  },
  "encoding": {
    "byteOrder": "big-endian",
    "textEncoding": "ascii"
  },
  "framing": {
    "style": "silence-delimited",
    "interFrameSilenceChars": 3.5
  },
  "integrityCheck": {
    "algorithm": "crc-16-modbus",
    "placement": "trailing",
    "coverage": "whole-frame-excluding-check",
    "valueEncoding": "binary"
  },
  "commandResponseModel": {
    "initiator": "client",
    "responseTimeoutMs": 1000,
    "retryPolicy": "application-level"
  },
  "fieldTypes": {
    "slaveAddress": {
      "baseType": "uint",
      "sizeBytes": 1
    },
    "functionCode": {
      "baseType": "enum",
      "sizeBytes": 1,
      "enumValues": {
        "1": "ReadCoils",
        "2": "ReadDiscreteInputs",
        "3": "ReadHoldingRegisters",
        "4": "ReadInputRegisters",
        "6": "WriteSingleRegister",
        "16": "WriteMultipleRegisters"
      }
    },
    "register": {
      "baseType": "uint",
      "sizeBytes": 2,
      "byteOrder": "big-endian"
    }
  },
  "commands": [
    {
      "name": "ReadCoilsRequest",
      "tags": ["modbus/coils"],
      "description": "Function 0x01: Read boolean coils status.",
      "fields": [
        {
          "name": "slaveAddress",
          "type": "slaveAddress"
        },
        {
          "name": "functionCode",
          "type": "functionCode",
          "constValue": 1,
          "role": "discriminator"
        },
        {
          "name": "startAddress",
          "type": "register"
        },
        {
          "name": "quantity",
          "type": "register",
          "units": "coils"
        }
      ]
    },
    {
      "name": "ReadDiscreteInputsRequest",
      "tags": ["modbus/inputs"],
      "description": "Function 0x02: Read discrete inputs status.",
      "fields": [
        {
          "name": "slaveAddress",
          "type": "slaveAddress"
        },
        {
          "name": "functionCode",
          "type": "functionCode",
          "constValue": 2,
          "role": "discriminator"
        },
        {
          "name": "startAddress",
          "type": "register"
        },
        {
          "name": "quantity",
          "type": "register",
          "units": "inputs"
        }
      ]
    },
    {
      "name": "ReadHoldingRegistersRequest",
      "tags": ["modbus/registers", "dashboard"],
      "description": "Function 0x03: Read a block of holding registers.",
      "fields": [
        {
          "name": "slaveAddress",
          "type": "slaveAddress"
        },
        {
          "name": "functionCode",
          "type": "functionCode",
          "constValue": 3,
          "role": "discriminator"
        },
        {
          "name": "startAddress",
          "type": "register"
        },
        {
          "name": "quantity",
          "type": "register",
          "units": "registers"
        }
      ]
    },
    {
      "name": "ReadInputRegistersRequest",
      "tags": ["modbus/input_registers"],
      "description": "Function 0x04: Read a block of input registers.",
      "fields": [
        {
          "name": "slaveAddress",
          "type": "slaveAddress"
        },
        {
          "name": "functionCode",
          "type": "functionCode",
          "constValue": 4,
          "role": "discriminator"
        },
        {
          "name": "startAddress",
          "type": "register"
        },
        {
          "name": "quantity",
          "type": "register",
          "units": "registers"
        }
      ]
    },
    {
      "name": "WriteSingleRegisterRequest",
      "tags": ["modbus/write"],
      "description": "Function 0x06: Write one holding register.",
      "fields": [
        {
          "name": "slaveAddress",
          "type": "slaveAddress"
        },
        {
          "name": "functionCode",
          "type": "functionCode",
          "constValue": 6,
          "role": "discriminator"
        },
        {
          "name": "registerAddress",
          "type": "register"
        },
        {
          "name": "value",
          "type": "register"
        }
      ]
    },
    {
      "name": "WriteMultipleRegistersRequest",
      "tags": ["modbus/write_multiple"],
      "description": "Function 0x10: Write multiple holding registers.",
      "fields": [
        {
          "name": "slaveAddress",
          "type": "slaveAddress"
        },
        {
          "name": "functionCode",
          "type": "functionCode",
          "constValue": 16,
          "role": "discriminator"
        },
        {
          "name": "startAddress",
          "type": "register"
        },
        {
          "name": "quantity",
          "type": "register",
          "units": "registers"
        },
        {
          "name": "byteCount",
          "type": "slaveAddress"
        }
      ]
    }
  ]
}