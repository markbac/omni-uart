        },
        {
          "name": "currentBattery",
          "type": "int",
          "sizeBytes": 2,
          "unit": "cA"
        },
        {
          "name": "batteryRemaining",
          "type": "int",
          "sizeBytes": 1,
          "unit": "%"
        }
      ]
    },
    {
      "name": "GPS_RAW_INT",
      "tags": ["telemetry/gps", "sensor"],
