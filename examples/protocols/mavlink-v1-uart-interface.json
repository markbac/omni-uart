          "unit": "rad/s"
        }
      ]
    },
    {
      "name": "COMMAND_LONG",
      "tags": ["command/action"],
      "description": "Message ID 76. Generic command dispatch to vehicle autopilot.",
      "fields": [
        {
          "name": "seq",
          "type": "seq",
          "position": "before-length-field"
        },
        {
          "name": "sysId",
          "type": "sysId",
          "position": "before-length-field"
        },
        {
          "name": "compId",
          "type": "compId",
          "position": "before-length-field"
        },
        {
          "name": "msgId",
          "type": "msgId",
          "constValue": 76,
          "position": "before-length-field",
          "role": "discriminator"
        },
        {
          "name": "targetSystem",
          "type": "uint",
