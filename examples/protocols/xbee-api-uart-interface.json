{
  "title": "XBee API Mode",
  "version": "S2C Zigbee firmware",
  "description": "Digi XBee radio module binary command protocol, including an AT Command frame setting ATCH (the RF channel/frequency).",
  "physicalLayer": {
    "dataBits": 8,
    "parity": "none",
    "stopBits": 1,
    "flowControl": "rts-cts",
    "wiringLines": [
      "TX",
      "RX",
      "GND",
      "RTS",
      "CTS"
    ],
    "hardwareFlowControlDetails": {
      "localRole": "dte",
      "rtsAssertedMeans": "Asserted by the host: while asserted, permits the module to transmit to the host.",
      "ctsAssertedMeans": "Asserted by the module: while asserted, permits the host to transmit to the module.",
      "notes": "Assumed for this example, matching the same convention as the PPPoS example."
    }
  },
  "encoding": {
    "byteOrder": "big-endian"
  },
  "framing": {
    "style": "sync-length-payload-crc",
    "syncBytes": [
      126
    ],
    "lengthField": {
      "sizeBytes": 2,
      "countsFrom": "payload-only"
    }
  },
  "integrityCheck": {
    "algorithm": "checksum-8",
    "finalTransform": "onesComplement",
    "placement": "trailing",
    "coverage": "payload-only"
  },
  "commandResponseModel": {
    "initiator": "either"
  },
  "fieldTypes": {
    "frameType": {
      "baseType": "enum",
      "sizeBytes": 1,
      "enumValues": {
        "8": "ATCommand",
        "16": "TransmitRequest",
        "23": "RemoteATCommand",
        "136": "ATCommandResponse"
      }
    }
  },
  "commands": [
    {
      "name": "SetChannelATCommand",
      "tags": ["xbee/at_command", "dashboard"],
      "description": "Frame type 0x08: local AT Command. The AT command here is 'CH' (RF channel/frequency), one of 16 channels in the 2.4GHz band.",
      "fields": [
        {
          "name": "frameType",
          "type": "frameType",
          "constValue": 8,
          "role": "discriminator"
        },
        {
          "name": "frameId",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "atCommand",
          "type": "string",
          "constValue": "CH"
        },
        {
          "name": "parameterValue",
          "type": "uint",
          "sizeBytes": 1,
          "description": "New channel number, e.g. 0x0C."
        }
      ]
    },
    {
      "name": "TransmitRequest",
      "tags": ["xbee/transmit"],
      "description": "Frame type 0x10: Transmit data packet to 64-bit destination address.",
      "fields": [
        {
          "name": "frameType",
          "type": "frameType",
          "constValue": 16,
          "role": "discriminator"
        },
        {
          "name": "frameId",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "dest64",
          "type": "bytes",
          "sizeBytes": 8
        },
        {
          "name": "dest16",
          "type": "uint",
          "sizeBytes": 2
        },
        {
          "name": "broadcastRadius",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "options",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "payload",
          "type": "bytes"
        }
      ]
    },
    {
      "name": "RemoteATCommand",
      "tags": ["xbee/remote_at"],
      "description": "Frame type 0x17: Issue AT Command to remote node in mesh network.",
      "fields": [
        {
          "name": "frameType",
          "type": "frameType",
          "constValue": 23,
          "role": "discriminator"
        },
        {
          "name": "frameId",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "dest64",
          "type": "bytes",
          "sizeBytes": 8
        },
        {
          "name": "dest16",
          "type": "uint",
          "sizeBytes": 2
        },
        {
          "name": "applyOptions",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "atCommand",
          "type": "string",
          "sizeBytes": 2
        }
      ]
    }
  ],
  "responses": [
    {
      "name": "ATCommandResponse",
      "fields": [
        {
          "name": "frameType",
          "type": "frameType",
          "constValue": 136,
          "role": "discriminator"
        },
        {
          "name": "frameId",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "atCommand",
          "type": "string",
          "sizeBytes": 2
        },
        {
          "name": "commandStatus",
          "type": "uint",
          "sizeBytes": 1
        }
      ]
    }
  ]
}