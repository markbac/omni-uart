{
  "title": "COBS-framed sensor stream",
  "version": "1.0",
  "description": "Consistent Overhead Byte Stuffing: the encoding itself guarantees the delimiter byte (0x00) never appears in the encoded data, so -- unlike delimiter-framed -- no escapeByte is needed at all.",
  "physicalLayer": {
    "dataBits": 8,
    "parity": "none",
    "stopBits": 1
  },
  "encoding": {
    "byteOrder": "little-endian"
  },
  "framing": {
    "style": "cobs",
    "endDelimiter": 0
  },
  "integrityCheck": {
    "algorithm": "crc-16-modbus",
    "placement": "trailing",
    "coverage": "whole-frame-excluding-check"
  },
  "commandResponseModel": {
    "initiator": "device"
  },
  "responses": [
    {
      "name": "SensorReading",
      "fields": [
        {
          "name": "sensorId",
          "type": "uint",
          "sizeBytes": 1
        },
        {
          "name": "value",
          "type": "float",
          "sizeBytes": 4
        }
      ]
    }
  ]
}