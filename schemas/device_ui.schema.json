{
  "$defs": {
    "DeviceIdentity": {
      "description": "Device identity metadata.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "model": {
          "default": "Generic Device",
          "title": "Model",
          "type": "string"
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor"
        },
        "version": {
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "device",
          "title": "Icon"
        }
      },
      "required": [
        "name"
      ],
      "title": "DeviceIdentity",
      "type": "object"
    },
    "GroupSpec": {
      "description": "Group container organizing widgets into logical sections.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "layout": {
          "default": "grid",
          "title": "Layout",
          "type": "string"
        },
        "widgets": {
          "items": {
            "$ref": "#/$defs/WidgetSpec"
          },
          "title": "Widgets",
          "type": "array"
        }
      },
      "required": [
        "name",
        "title"
      ],
      "title": "GroupSpec",
      "type": "object"
    },
    "PanelSpec": {
      "description": "Navigation panel or tab organizing groups.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/GroupSpec"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "name",
        "title"
      ],
      "title": "PanelSpec",
      "type": "object"
    },
    "SafetyRuleSpec": {
      "description": "Safety and confirmation rule for high-risk operations.",
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "require_confirmation": {
          "default": true,
          "title": "Require Confirmation",
          "type": "boolean"
        },
        "warning_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warning Message"
        },
        "danger_zone": {
          "default": false,
          "title": "Danger Zone",
          "type": "boolean"
        }
      },
      "required": [
        "command"
      ],
      "title": "SafetyRuleSpec",
      "type": "object"
    },
    "WidgetSpec": {
      "description": "Declarative UI control or telemetry widget element.",
      "properties": {
        "widget_type": {
          "description": "Widget type: slider, switch, button, dropdown, gauge, line_plot, badge, text",
          "title": "Widget Type",
          "type": "string"
        },
        "field_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mapped protocol field or command parameter",
          "title": "Field Ref"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "options": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "presentation_hints": {
          "additionalProperties": true,
          "title": "Presentation Hints",
          "type": "object"
        }
      },
      "required": [
        "widget_type",
        "label"
      ],
      "title": "WidgetSpec",
      "type": "object"
    }
  },
  "description": "Declarative Device UI Specification model.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/DeviceIdentity"
    },
    "protocol_ref": {
      "title": "Protocol Ref",
      "type": "string"
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/PanelSpec"
      },
      "title": "Panels",
      "type": "array"
    },
    "safety_rules": {
      "items": {
        "$ref": "#/$defs/SafetyRuleSpec"
      },
      "title": "Safety Rules",
      "type": "array"
    }
  },
  "required": [
    "identity",
    "protocol_ref"
  ],
  "title": "DeviceUISpec",
  "type": "object"
}